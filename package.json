{
  "name": "shipment-triage-agent-ts",
  "version": "1.0.0",
  "description": "Shipment triage agent",
  "scripts": {
    "triage": "tsx main.ts triage",
    "resume": "tsx main.ts resume",
    "db:check": "tsx db-check.ts",
    "server": "tsx watch server/index.ts",
    "web": "npm --prefix web start",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run server\" \"npm run web\"",
    "build": "npm --prefix web run build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "evals:redteam:generate": "promptfoo redteam generate -c evals/redteam.yaml -o evals/redteam-cases.yaml --force",
    "evals:redteam:run": "promptfoo redteam eval -c evals/redteam-cases.yaml -o evals/redteam-report.yaml -j 1",
    "evals:redteam": "npm run evals:redteam:generate && npm run evals:redteam:run",
    "evals:list": "promptfoo list evals",
    "evals:view": "promptfoo view -y"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.7",
    "@langchain/core": "^1.3.2",
    "@langchain/langgraph": "^1.6.0",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.2",
    "@langchain/openai": "^1.8.0",
    "@langfuse/otel": "^6.1.1",
    "@langfuse/tracing": "^6.1.1",
    "@opentelemetry/api": "~1.9.1",
    "@opentelemetry/sdk-trace-node": "^2.12.1",
    "dotenv": "^18.0.9",
    "hono": "^4.13.18",
    "langchain": "^1.6.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.7",
    "promptfoo": "^0.125.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "private": true
}
